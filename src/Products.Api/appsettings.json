{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ProductsDb": "Data Source=products.db"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "products-api",
    "Audience": "products-api",
    "SigningKey": "",
    "TokenLifetime": "01:00:00"
  },
  "Auth": {
    "Users": []
  },
  "Outbox": {
    "Enabled": true,
    "PollingInterval": "00:00:05",
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
