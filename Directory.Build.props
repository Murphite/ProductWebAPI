<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      CA1515: public types are required by WebApplicationFactory/test projects.
      CA1062: nullable reference types already cover argument null checks.
      CA1707: underscores are used in test method names.
      CA2007: ConfigureAwait is unnecessary in ASP.NET Core (no SynchronizationContext).
    -->
    <NoWarn>$(NoWarn);CA1515;CA1062;CA1707;CA2007</NoWarn>
  </PropertyGroup>
</Project>
